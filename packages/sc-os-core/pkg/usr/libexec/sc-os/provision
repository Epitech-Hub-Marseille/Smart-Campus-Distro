#!/bin/sh
# First-boot provisioning, run by sc-os-provision.service before sc-update.
# Creates what the product needs and cannot take from its repository.
# Safe to run on every boot: nothing that exists is touched.
set -eu

STATE_DIR=/var/lib/sc-os
CONFIG_DIR=/etc/sc-os
SERVER_KEY="$STATE_DIR/server-key.pem"
SERVER_ENV="$CONFIG_DIR/central-server.env"
# The server container runs as "node" (uid 1000) and must read the mounted key.
CONTAINER_UID=1000

# shellcheck source=/dev/null
. "$CONFIG_DIR/product"

random_password() {
  # 18 random bytes as base64, minus characters that need quoting in an env file.
  openssl rand -base64 18 | tr -d '/+='
}

create_server_key() {
  [ -f "$SERVER_KEY" ] && return 0
  mkdir -p "$STATE_DIR"
  # Losing this key means re-provisioning every device, so it is never regenerated.
  openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$SERVER_KEY"
  chown "$CONTAINER_UID:$CONTAINER_UID" "$SERVER_KEY"
  chmod 0400 "$SERVER_KEY"
}

create_server_env() {
  [ -f "$SERVER_ENV" ] && return 0
  umask 077
  cat >"$SERVER_ENV" <<ENV
# Settings of the central server stack (docker compose --env-file).
# The full list is in .env.example of the SmartCampus-CentralServer repository.
# After a change: sc-os-apply
APP_URL=http://$(hostname):3000
ALLOWED_ORIGINS=
CAMPUS_TIMEZONE=Europe/Paris
TWO_FACTOR_KEY=$(openssl rand -base64 32)
SEED_ADMIN_EMAIL=admin@smartcampus.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=$(random_password)
ENV
}

case "$PRODUCT" in
  central-server)
    create_server_key
    create_server_env
    ;;
  *)
    # The faculty screen cannot be provisioned alone: it needs the address and
    # public key of a server. That is done by sc-os-setup.
    ;;
esac
