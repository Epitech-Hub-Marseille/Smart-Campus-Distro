#!/usr/bin/env python3
"""sc-update - Smart Campus updater.

Two things are kept up to date:

* the OS packages (sc-os-core, sc-update, ...): the latest release tag of the
  distro repository is built on the machine and installed (see os_update.py);
* the product: the latest tag (or latest commit, if untagged) on the `main`
  branch of the repository in /opt/smart-campus, then the docker compose project
  is rebuilt and started.

Each update is applied automatically or after asking the user (via Plymouth and
the shell/console). Progress is reported to Plymouth (see plymouth_report.py).

  sc-update           check and apply updates (runs at boot as a systemd service)
  sc-update --check   only check, and write /var/lib/sc-update/status.json

Exit codes:
  0  up to date, updated successfully, or update cancelled (not an error)
  1  failure (could not check, or an update failed)
"""
from __future__ import annotations

import argparse
import fcntl
import json
import logging
import os
import select
import shutil
import subprocess
import sys
import termios
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Callable, Optional

import yaml

sys.dont_write_bytecode = True  # do not leave __pycache__ inside the package directory
sys.path.insert(0, str(Path(__file__).resolve().parent))

import gitrepo  # noqa: E402
import os_update  # noqa: E402
from gitrepo import SHORT_SHA_LENGTH, STATE_DIR  # noqa: E402,F401
from plymouth_report import Plymouth, StepCounter, UpdateProgress  # noqa: E402
from process import UpdateFailed, run_streamed  # noqa: E402

CONFIG_PATH = Path("/etc/sc-update/config.yaml")
VERSION_PATH = Path("/etc/sc-update/version")
STATUS_PATH = STATE_DIR / "status.json"
# Not /bin: it is a symlink to /usr/bin on Debian and must not hold mutable data.
REPO_DIR = Path("/opt/smart-campus")
OVERRIDE_PATH = STATE_DIR / "restart-override.yml"
LOCK_PATH = Path("/run/sc-update.lock")
COMPOSE_NAMES = ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")
COMPOSE_ENV = {"COMPOSE_ANSI": "never", "BUILDKIT_PROGRESS": "plain",
               "COMPOSE_PROGRESS": "plain", "DOCKER_CLI_HINTS": "false"}

DEFAULT_AUTO_UPDATE = True
DEFAULT_AUTOREJECT_SECONDS = 15

# Share of the Plymouth bar given to each stage, when that stage runs.
STAGE_WEIGHTS = (("os-build", 25), ("os-install", 15),
                 ("product-checkout", 5), ("product-containers", 55))
# build-sc-os.sh builds this many packages for a product with a screen (one less without).
BUILD_PACKAGES_ESTIMATE = 4

log = logging.getLogger("sc-update")
ply = Plymouth()


def say(text: str, level: int = logging.INFO) -> None:
    """Log to the journal and show the same text on the Plymouth splash."""
    log.log(level, text)
    ply.message(f"Smart Campus: {text}")


# --------------------------------------------------------------------------
# Config / version
# --------------------------------------------------------------------------
def _to_bool(value, default: bool) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        s = value.strip().lower()
        if s in ("true", "yes", "on", "1"):
            return True
        if s in ("false", "no", "off", "0"):
            return False
    log.warning("auto-update: invalid value %r, using default %s", value, default)
    return default


def _to_path_list(value) -> list[Path]:
    """Accept a YAML list of paths; anything else (including missing) is empty."""
    if value is None:
        return []
    if not isinstance(value, list):
        log.warning("expected a list of paths, got %r, ignoring it", value)
        return []
    return [Path(str(item)) for item in value]


def load_config() -> dict:
    raw: dict = {}
    try:
        with CONFIG_PATH.open() as fh:
            raw = yaml.safe_load(fh) or {}
    except FileNotFoundError:
        log.warning("%s not found, using defaults", CONFIG_PATH)
    except (OSError, yaml.YAMLError) as exc:
        raise UpdateFailed(f"cannot read {CONFIG_PATH}: {exc}")
    if not isinstance(raw, dict):
        raise UpdateFailed(f"{CONFIG_PATH} must contain a YAML mapping")

    cfg = {
        "auto-update": _to_bool(raw.get("auto-update", DEFAULT_AUTO_UPDATE),
                                DEFAULT_AUTO_UPDATE),
        "conditional-update-autoreject-seconds": float(DEFAULT_AUTOREJECT_SECONDS),
        "repository-url": raw.get("repository-url") or None,
        "os-repository-url": raw.get("os-repository-url") or None,
        "os-update": _to_bool(raw.get("os-update", True), True),
        "compose-env-file": raw.get("compose-env-file") or None,
        "compose-overrides": _to_path_list(raw.get("compose-overrides")),
        "required-files": _to_path_list(raw.get("required-files")),
    }
    if "conditional-update-autoreject-seconds" in raw:
        value = raw["conditional-update-autoreject-seconds"]
        try:
            if isinstance(value, bool):
                raise ValueError
            seconds = float(value)
            if seconds < 0:
                raise ValueError
            cfg["conditional-update-autoreject-seconds"] = seconds
        except (TypeError, ValueError):
            log.warning("conditional-update-autoreject-seconds: invalid value %r, "
                        "using default %s", value, DEFAULT_AUTOREJECT_SECONDS)
    return cfg


def read_version() -> str:
    try:
        return VERSION_PATH.read_text().strip()
    except FileNotFoundError:
        return ""
    except OSError as exc:
        raise UpdateFailed(f"cannot read {VERSION_PATH}: {exc}")


def write_version(tag: str) -> None:
    tmp = VERSION_PATH.with_suffix(".tmp")
    try:
        tmp.write_text(tag + "\n")
        os.replace(tmp, VERSION_PATH)
    except OSError as exc:
        raise UpdateFailed(f"cannot write {VERSION_PATH}: {exc}")


# --------------------------------------------------------------------------
# Product repository (the helpers are in gitrepo.py)
# --------------------------------------------------------------------------
def git(*args: str, check: bool = True) -> str:
    return gitrepo.git(REPO_DIR, *args, check=check)


def ensure_repo(cfg: dict) -> None:
    if (REPO_DIR / ".git").exists():
        return
    url = cfg.get("repository-url")
    if not url:
        raise UpdateFailed(
            f"{REPO_DIR} is not a git repository and no 'repository-url' is set "
            f"in {CONFIG_PATH}")
    say(f"cloning repository from {url}")
    gitrepo.clone(url, REPO_DIR)


def latest_version() -> str:
    return gitrepo.latest_version(REPO_DIR)


# --------------------------------------------------------------------------
# Asking the user (Plymouth + shell/console, first answer wins)
# --------------------------------------------------------------------------
def _write_console(text: str) -> None:
    if sys.stdout.isatty():
        print(text, flush=True)
        return
    try:
        with open("/dev/console", "w") as con:
            con.write(text + "\n")
    except OSError:
        pass


def ask_user(label: str, current: str, latest: str, timeout: float) -> Optional[bool]:
    """Return True = accepted, False = rejected, None = timed out."""
    prompt = (f"{label} update available: {current or 'none'} -> {latest}. "
              f"Install now? [y/N] (auto-cancel in {int(timeout)}s)")
    sources: dict[int, str] = {}
    own_fd: Optional[int] = None
    proc: Optional[subprocess.Popen] = None

    if sys.stdin.isatty():
        sources[sys.stdin.fileno()] = "shell"
    else:
        try:
            own_fd = os.open("/dev/console", os.O_RDONLY | os.O_NONBLOCK | os.O_NOCTTY)
            sources[own_fd] = "console"
        except OSError:
            pass
    for fd in list(sources):
        try:
            termios.tcflush(fd, termios.TCIFLUSH)
        except (termios.error, OSError):
            pass

    _write_console(f"[sc-update] {prompt}")
    log.info(prompt)

    if ply.active():
        try:
            proc = subprocess.Popen(
                [ply.exe, "ask-question", f"--prompt={prompt}"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            sources[proc.stdout.fileno()] = "plymouth"
        except OSError:
            proc = None

    deadline = time.monotonic() + timeout
    result: Optional[bool] = None
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            if not sources:          # no input channel at all: just wait it out
                time.sleep(min(remaining, 1.0))
                continue
            ready, _, _ = select.select(list(sources), [], [], remaining)
            for fd in ready:
                try:
                    data = os.read(fd, 1024)
                except BlockingIOError:
                    continue
                except OSError:
                    data = b""
                if not data:
                    sources.pop(fd, None)
                    continue
                answer = data.decode(errors="replace").strip().lower()
                log.info("answer received from %s: %r", sources[fd], answer)
                result = answer in ("y", "yes")
                return result
    finally:
        if proc is not None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
            if proc.stdout:
                proc.stdout.close()
        if own_fd is not None:
            os.close(own_fd)
    return result


# --------------------------------------------------------------------------
# Docker compose
# --------------------------------------------------------------------------
def compose_base() -> list[str]:
    if shutil.which("docker"):
        res = subprocess.run(["docker", "compose", "version"],
                             capture_output=True, text=True)
        if res.returncode == 0:
            return ["docker", "compose"]
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    raise UpdateFailed("docker compose is not installed")


def compose_up(cfg: dict, on_line: Optional[Callable[[str], None]] = None) -> None:
    compose_file = next((REPO_DIR / n for n in COMPOSE_NAMES if (REPO_DIR / n).is_file()), None)
    if compose_file is None:
        raise UpdateFailed(f"no docker compose file found in {REPO_DIR}")
    base = compose_base() + ["--project-directory", str(REPO_DIR), "-f", str(compose_file)]
    if cfg["compose-env-file"]:
        base += ["--env-file", cfg["compose-env-file"]]
    for override in cfg["compose-overrides"]:
        base += ["-f", str(override)]

    res = subprocess.run(base + ["config", "--services"], capture_output=True, text=True)
    if res.returncode != 0:
        raise UpdateFailed(f"invalid compose file: {res.stderr.strip()}")
    services = [s.strip() for s in res.stdout.splitlines() if s.strip()]
    if not services:
        raise UpdateFailed("compose file defines no services")

    # Force restart: always so docker keeps everything up (and brings it back
    # after the next reboot) without touching the repository's own files.
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    OVERRIDE_PATH.write_text(
        "services:\n" + "".join(f"  {s}:\n    restart: always\n" for s in services))

    run_streamed(base + ["-f", str(OVERRIDE_PATH), "up", "-d", "--build", "--remove-orphans"],
                 cwd=REPO_DIR, extra_env=COMPOSE_ENV, on_line=on_line)


# --------------------------------------------------------------------------
# Updates
# --------------------------------------------------------------------------
def apply_update(tag: str, cfg: dict, progress: UpdateProgress) -> None:
    """Check out the product release and rebuild its containers; roll back if that fails."""
    previous = git("rev-parse", "HEAD", check=False)
    try:
        progress.start("product-checkout", f"updating to {tag}")
        # `tag` is a tag name or, for untagged repositories, a commit id: both resolve here.
        git("checkout", "--force", "--detach", tag)
        progress.finish(f"Product {tag} checked out")

        progress.start("product-containers", f"building and starting containers for {tag}")
        counter = StepCounter()

        def on_compose_line(line: str) -> None:
            counter.feed(line)
            progress.set_fraction(counter.fraction())

        compose_up(cfg, on_compose_line)
        progress.finish(f"Containers running for {tag}")
    except UpdateFailed:
        if previous:
            log.error("update failed, restoring previous revision %s", previous[:12])
            try:
                git("checkout", "--force", "--detach", previous)
                compose_up(cfg)
            except UpdateFailed as exc:
                log.error("rollback also failed: %s", exc)
        raise
    write_version(tag)
    say(f"updated to {tag}")


def apply_os_update(version: str, progress: UpdateProgress) -> None:
    """Build the OS packages of a release and install them.

    No rollback: a failed build leaves the installed packages untouched, and a
    failed install is left to dpkg. The next boot tries again.
    """
    progress.start("os-build", f"building system packages {version}")
    build_counter = StepCounter(expected=BUILD_PACKAGES_ESTIMATE)

    def on_build_line(line: str) -> None:
        build_counter.feed(line)
        progress.set_fraction(build_counter.fraction())

    packages = os_update.build_packages(version, on_build_line)
    progress.finish(f"System packages {version} built")

    progress.start("os-install", f"installing system packages {version}")
    install_counter = StepCounter(expected=len(packages))

    def on_install_line(line: str) -> None:
        install_counter.feed(line)
        progress.set_fraction(install_counter.fraction())

    os_update.install_packages(packages, on_install_line)
    progress.finish(f"System packages {version} installed")
    log.info("system packages updated: a new boot splash or kernel setting needs a reboot")


def check_os(cfg: dict) -> Optional[dict]:
    """State of the OS packages; None when OS updates are off or could not be checked.

    A failed check is only logged: the product update must not depend on it.
    """
    url = cfg["os-repository-url"]
    if not url or not cfg["os-update"]:
        return None
    installed = os_update.installed_version()
    try:
        latest = os_update.latest_release(url)
    except UpdateFailed as exc:
        log.warning("cannot check OS updates: %s", exc)
        return None
    return {"installed": installed, "latest": latest,
            "update-available": bool(latest) and os_update.is_newer(latest, installed)}


def check_product() -> dict:
    current = read_version()
    latest = latest_version()
    return {"installed": current, "latest": latest,
            "update-available": bool(latest) and latest != current}


def write_status(os_state: Optional[dict], product_state: dict) -> None:
    """Record what the last check found, for whoever wants to know if updates wait."""
    status = {"checked-at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
              "os": os_state, "product": product_state}
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATUS_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(status, indent=2) + "\n")
    os.replace(tmp, STATUS_PATH)


def describe(name: str, state: Optional[dict]) -> str:
    if state is None:
        return f"{name}: not checked"
    verdict = "update available" if state["update-available"] else "up to date"
    return (f"{name}: installed {state['installed'] or 'none'}, "
            f"latest {state['latest'] or 'none'} ({verdict})")


def wanted(cfg: dict, label: str, state: Optional[dict]) -> bool:
    """True when the update is pending and applying it is accepted (automatically or by the user)."""
    if state is None or not state["update-available"]:
        return False
    log.info("%s: installed=%r latest=%r", label, state["installed"] or "none", state["latest"])
    if cfg["auto-update"]:
        return True
    answer = ask_user(label, state["installed"], state["latest"],
                      cfg["conditional-update-autoreject-seconds"])
    if not answer:
        say(f"{label} update cancelled" + (" (no answer before timeout)" if answer is None else " by user"))
    return bool(answer)


def update_stages(with_os: bool, with_product: bool) -> list[tuple[str, int]]:
    """The progress stages of this run, in order, so the bar fills over what is really done."""
    kept = []
    for name, weight in STAGE_WEIGHTS:
        if name.startswith("os-") and with_os or name.startswith("product-") and with_product:
            kept.append((name, weight))
    return kept


def run(check_only: bool = False) -> int:
    cfg = load_config()
    ensure_repo(cfg)

    missing = [str(p) for p in cfg["required-files"] if not p.is_file()]
    if missing and not check_only:
        # Not a failure: a freshly installed machine waits for `sc-os-setup`,
        # which starts this service again once the files exist.
        say("waiting for setup, missing " + ", ".join(missing))
        return 0

    if check_only:
        log.info("checking for updates")
    else:
        say("checking for updates")
    os_state = check_os(cfg)
    product_state = check_product()
    write_status(os_state, product_state)
    if check_only:
        log.info(describe("OS packages", os_state))
        log.info(describe("Product", product_state))
        return 0

    os_pending = bool(os_state and os_state["update-available"])
    if not os_pending and not product_state["update-available"]:
        say(f"up to date ({product_state['installed']})")
        return 0

    with_os = wanted(cfg, "OS packages", os_state)
    with_product = wanted(cfg, "Product", product_state)
    if not with_os and not with_product:
        return 0  # every pending update was declined, and wanted() said so

    return apply_updates(cfg, with_os, os_state, with_product, product_state)


def apply_updates(cfg: dict, with_os: bool, os_state: Optional[dict],
                  with_product: bool, product_state: dict) -> int:
    """Run the accepted updates behind the Plymouth update bar. One failing must not stop the other."""
    progress = UpdateProgress(ply, update_stages(with_os, with_product))
    failures: list[str] = []
    ply.start_updates()
    try:
        if with_os:
            try:
                apply_os_update(os_state["latest"], progress)
            except UpdateFailed as exc:
                say(f"SYSTEM UPDATE FAILED: {exc}", logging.ERROR)
                failures.append(str(exc))
        if with_product:
            try:
                apply_update(product_state["latest"], cfg, progress)
            except UpdateFailed as exc:
                say(f"PRODUCT UPDATE FAILED: {exc}", logging.ERROR)
                failures.append(str(exc))
    finally:
        ply.finish_updates()
    return 1 if failures else 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Smart Campus updater")
    parser.add_argument("--check", action="store_true",
                        help="only check for updates and write the status file")
    args = parser.parse_args()

    logging.basicConfig(stream=sys.stdout, level=logging.INFO, format="%(message)s")
    if os.geteuid() != 0:
        log.error("must be run as root")
        return 1
    lock = open(LOCK_PATH, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log.info("another sc-update instance is running, exiting")
        return 0
    try:
        return run(check_only=args.check)
    except UpdateFailed as exc:
        say(f"UPDATE FAILED: {exc}", logging.ERROR)
        return 1
    except Exception:  # noqa: BLE001
        log.exception("unexpected error")
        ply.message("Smart Campus: UPDATE FAILED (unexpected error)")
        return 1


if __name__ == "__main__":
    sys.exit(main())
